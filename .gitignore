# ========================================
# TDPokerPro Platform - .gitignore
# ========================================

# ====================
# SYSTEM FILES
# ====================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# ====================
# NODE.JS / BACKEND
# ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Distribution
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.eslintcache

# ====================
# FLUTTER / FRONTEND
# ====================
# Files and directories created by pub
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Android related
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

# iOS/XCode related
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# Web related
**/web/flutter_service_worker.js

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Coverage
coverage/
*.lcov

# ====================
# DATABASE
# ====================
*.db
*.sqlite
*.sqlite3
postgres-data/
redis-data/
elasticsearch-data/

# ====================
# DOCKER
# ====================
docker-compose.override.yml
.docker/

# ====================
# LOGS
# ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================
# SECRETS & CREDENTIALS
# ====================
secrets/
*.pem
*.key
*.cert
*.crt
.secrets
credentials.json

# ====================
# TESTING & TEMPORARY
# ====================
tmp/
temp/
*.tmp
test-results/
.test-results/

# ====================
# KUBERNETES
# ====================
infrastructure/kubernetes/secrets/
*.secret.yaml

# ====================
# OS SPECIFIC
# ====================
# macOS
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Windows
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
