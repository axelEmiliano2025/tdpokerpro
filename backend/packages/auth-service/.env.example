# Authentication Service Environment Variables

# Application
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tdpokerpro_dev
DB_USER=tdpokerpro_user
DB_PASSWORD=tdpokerpro_dev_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
# Format: Use time strings like "1h", "2h", "24h", "7d", "30d"
# or numbers representing seconds
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d
