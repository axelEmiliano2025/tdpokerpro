{
    "name": "@tdpokerpro/database",
    "version": "1.0.0",
    "description": "TDPokerPro Database - Migrations, schemas and seeds",
    "private": true,
    "scripts": {
        "migrate:create": "node-pg-migrate create --migrations-dir migrations",
        "migrate:up": "node-pg-migrate up --migrations-dir migrations",
        "migrate:down": "node-pg-migrate down --migrations-dir migrations",
        "migrate:redo": "node-pg-migrate redo --migrations-dir migrations",
        "seed": "node scripts/seed.js",
        "db:reset": "node-pg-migrate down 0 --migrations-dir migrations && node-pg-migrate up --migrations-dir migrations && yarn seed",
        "db:status": "node scripts/db-status.js"
    },
    "dependencies": {
        "dotenv": "^16.3.1",
        "node-pg-migrate": "^6.2.2",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/pg": "^8.10.9",
        "typescript": "^5.3.2"
    },
    "keywords": [
        "database",
        "postgresql",
        "migrations",
        "seeds"
    ],
    "author": "TDPokerPro Team",
    "license": "UNLICENSED"
}