{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@tdpokerpro/shared-types": [
                "../shared-types/src"
            ],
            "@tdpokerpro/shared-utils": [
                "../shared-utils/src"
            ]
        }
    },
    "references": [
        {
            "path": "../shared-types"
        },
        {
            "path": "../shared-utils"
        }
    ],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}